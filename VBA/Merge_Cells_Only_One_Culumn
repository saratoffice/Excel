Sub Total_And_Merge_Only_N()

    Dim ws As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim startRow As Long
    Dim millName As String
    Dim totalQty As Double

    Set ws = ActiveSheet
    lastRow = ws.Cells(ws.Rows.Count, "J").End(xlUp).Row

    ' Clear previous merges and totals in N
    ws.Range("N2:N" & lastRow).UnMerge
    ws.Range("N2:N" & lastRow).ClearContents

    i = 2

    Do While i <= lastRow

        startRow = i
        millName = ws.Cells(i, "J").Value
        totalQty = 0

        ' Sum Quantity allotted for same Mill Name
        Do While i <= lastRow And ws.Cells(i, "J").Value = millName
            totalQty = totalQty + ws.Cells(i, "M").Value
            i = i + 1
        Loop

        ' Write total in first row only
        ws.Cells(startRow, "N").Value = totalQty

        ' Merge ONLY column N
        If i - startRow > 1 Then
            ws.Range("N" & startRow & ":N" & i - 1).Merge
            ws.Range("N" & startRow).VerticalAlignment = xlCenter
        End If

    Loop

End Sub

